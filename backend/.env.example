DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Home-terminal time zone used for the default 06:00 start and to normalise aware datetimes
HOME_TERMINAL_TZ=America/Chicago
# Free key from https://openrouteservice.org/dev/#/signup (optional; falls back to Nominatim/Photon + OSRM)
ORS_API_KEY=
NOMINATIM_USER_AGENT=eld-trip-planner/1.0 (contact: you@example.com)
GEOCODE_COUNTRY_CODES=us,ca
HTTP_TIMEOUT_SECONDS=12
REVERSE_GEOCODE_BUDGET_SECONDS=25
